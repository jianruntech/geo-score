#!/usr/bin/env bash
# Enable once per clone: git config core.hooksPath .githooks
# Runs the same gate as CI before anything leaves your machine. Skip in an emergency with --no-verify.
root="$(git rev-parse --show-toplevel)"
# the gate checks the working tree, but a push sends commits: with uncommitted changes, a pass
# would describe files that are not being pushed
if [ -n "$(git -C "$root" status --porcelain)" ]; then
  echo "pre-push: uncommitted changes; commit or stash them so the gate checks what you push" >&2
  exit 1
fi
exec bash "$root/scripts/check.sh"
