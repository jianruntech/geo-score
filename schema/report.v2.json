{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jianruntech/geo-score/main/schema/report.v2.json",
  "title": "AIV audit report (rubric v1.1+)",
  "description": "Emit this and your results are comparable with anyone else's. v2 replaces v1 because rubric v1.1 changed the output shape: a single `score` became `readiness` reported alongside an unscored citation block, checks carry the tier they reached rather than a pass/fail verdict, and gate checks can cap the total. v1 stays published — reports written against rubric v1.0 remain valid under it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rubric_version",
    "audited_at",
    "target",
    "sampled_urls",
    "checks",
    "readiness",
    "observable_max",
    "normalised",
    "band",
    "gate_capped"
  ],
  "properties": {
    "rubric_version": {
      "type": "string",
      "pattern": "^v1\\.[1-9]\\d*$",
      "description": "The rubric this was scored against. A score without it is not comparable to anything."
    },
    "audited_at": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-DD"
    },
    "target": {
      "type": "string",
      "format": "uri"
    },
    "audience_language": {
      "type": "string",
      "description": "BCP 47. Drives the answer-passage length rule: 25–120 words for English, 50–200 characters for Chinese."
    },
    "sampled_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1,
      "description": "Exactly 8 unless the site has fewer pages; if fewer, say so in notes."
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "g.robots",
              "g.reachable",
              "g.ssr",
              "p1.sitemap",
              "p1.llms-txt",
              "p1.organization",
              "p1.breadcrumb",
              "p1.page-type",
              "p2.answer-passages",
              "p2.question-intent",
              "p2.freshness",
              "p2.sourced-stats",
              "p2.named-author",
              "p3.listings",
              "p3.mentions",
              "p3.knowledge-graph",
              "p3.sameas",
              "p3.video",
              "p4.answer-shape",
              "p4.question-coverage",
              "p4.cn-engines",
              "b.llms-full",
              "b.ai-txt",
              "b.geo-link",
              "b.speakable"
            ],
            "description": "A check id from rubric v1.1. Ids are permanent."
          },
          "state": {
            "enum": [
              "scored",
              "unobservable",
              "not_applicable"
            ],
            "description": "No `failed` state: under tiered scoring a check that meets nothing is `scored` at tier 1 with 0 points, which keeps it in the denominator. `unobservable` and `not_applicable` leave the denominator."
          },
          "points": {
            "type": "integer",
            "minimum": 0,
            "description": "The tier actually reached. Required when state is `scored`."
          },
          "max": {
            "type": "integer",
            "minimum": 1
          },
          "tier_reason": {
            "type": "string",
            "minLength": 1,
            "description": "Why this tier and not the next one up. This is the line a reader acts on."
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "description": "Reproducible observation: status codes, byte counts, hashes, N of 8 pages, the actual sentence."
          },
          "reason": {
            "type": "string",
            "description": "Required when state is `unobservable` or `not_applicable`."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "scored"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "required": [
                "points",
                "max",
                "evidence",
                "tier_reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "unobservable",
                    "not_applicable"
                  ]
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        ]
      }
    },
    "readiness": {
      "type": "integer",
      "minimum": 0,
      "description": "Sum of scored points including bonus. Bonus caps at +6 and stays out of the denominator."
    },
    "observable_max": {
      "type": "integer",
      "minimum": 1,
      "description": "Sum of max for checks still in the denominator. Never 100 unless nothing was excluded."
    },
    "normalised": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "round(100 × readiness / observable_max), then capped at 40 if gate_capped."
    },
    "band": {
      "type": "string",
      "enum": [
        "Leading",
        "Solid",
        "Growing",
        "Early",
        "Not started",
        "领先",
        "基础扎实",
        "成长期",
        "起步期",
        "未起步"
      ],
      "description": "Band name in either English or Chinese, exactly as the rubric spells it."
    },
    "gate_capped": {
      "type": "boolean",
      "description": "True when g.robots, g.reachable or g.ssr fell short of full marks. Then normalised caps at 40 and the report leads with it."
    },
    "bonus_awarded": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Whether engines actually cite the site. An outcome, never summed into readiness. Omit the object entirely rather than reporting a zero you did not measure.",
      "properties": {
        "measured": {
          "type": "boolean"
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cited_count": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "measured"
      ]
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "g.robots",
              "g.reachable",
              "g.ssr",
              "p1.sitemap",
              "p1.llms-txt",
              "p1.organization",
              "p1.breadcrumb",
              "p1.page-type",
              "p2.answer-passages",
              "p2.question-intent",
              "p2.freshness",
              "p2.sourced-stats",
              "p2.named-author",
              "p3.listings",
              "p3.mentions",
              "p3.knowledge-graph",
              "p3.sameas",
              "p3.video",
              "p4.answer-shape",
              "p4.question-coverage",
              "p4.cn-engines",
              "b.llms-full",
              "b.ai-txt",
              "b.geo-link",
              "b.speakable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Every check that left the denominator, with why. Without this the max is unexplainable."
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "The auditor's own caveats. An audit that hides its blind spots is worth less than a lower score."
    }
  }
}
